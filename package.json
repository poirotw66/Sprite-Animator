{
  "name": "sprite-animator",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fonts:build": "tsx scripts/build-browser-fonts.mts",
    "fonts:check": "tsx scripts/build-browser-fonts.mts --check",
    "previews:build": "tsx scripts/build-style-preview-thumbnails.mts",
    "previews:check": "tsx scripts/build-style-preview-thumbnails.mts --check",
    "python:sync": "uv sync --locked --dev",
    "python:test": "uv run --locked python -B -m pytest",
    "python:self-check": "uv run --locked python -B scripts/line-sticker/python/sheet_converter_v2/convert.py --self-check",
    "python:check": "npm run python:test && npm run python:self-check",
    "security:audit": "tsx scripts/security-audit.mts",
    "security:secrets": "tsx scripts/scan-secrets.mts",
    "security:bundle": "tsx scripts/scan-secrets.mts --include-dist",
    "dist:budget": "tsx scripts/check-dist-budget.mts",
    "skills:sync:line-sticker": "tsx scripts/line-sticker/sync-line-sticker-skills.mts",
    "skills:check:line-sticker": "tsx scripts/line-sticker/sync-line-sticker-skills.mts --check",
    "ci": "npm run security:audit && npm run security:secrets && npm run skills:sync:line-sticker && npm run skills:check:line-sticker && npm run typecheck && npm run lint && npm run previews:check && npm run test && npm run test:e2e && npm run python:check && npm run build && npm run security:bundle && npm run dist:budget",
    "predev": "npm run fonts:build && npm run previews:check",
    "prebuild": "npm run fonts:build && npm run fonts:check",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@huggingface/transformers": "^4.2.0",
    "gifenc": "1.0.3",
    "jszip": "3.10.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.2",
    "upng-js": "2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jpeg-js": "^0.4.4",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "protobufjs": "7.6.5",
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=20 <27",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2"
}
